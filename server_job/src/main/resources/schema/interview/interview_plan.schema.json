{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewPlan",
  "type": "object",
  "required": ["plan_id", "version", "questions"],
  "properties": {
    "plan_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "target_role": { "type": "string" },
    "source_material_hash": { "type": "string" },
    "rubric_version": { "type": "string" },
    "planner_model": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "dimensions": { "type": "array", "items": { "type": "string" } },
          "weight": { "type": "number" },
          "thinking_hint": { "type": "string" },
          "timeout_seconds": { "type": "integer" },
          "preset_followups": { "type": "array", "items": { "type": "string" } },
          "reference_answer": { "type": "string" },
          "eval_criteria": { "type": "object" }
        }
      }
    }
  }
}
