# ====================== RocketMQ（连 ~/workspace/docker compose）======================
# 业务只连 Proxy gRPC，不要填 NameServer 9876 / 勿用 host.docker.internal
ROCKETMQ_PROXY_GRPC_ENDPOINT=127.0.0.1:18081
ROCKETMQ_PROXY_ENDPOINT=127.0.0.1:18080
ROCKETMQ_SSL_ENABLED=false
ROCKETMQ_REQUEST_TIMEOUT=10

ROCKETMQ_PRODUCER_GROUP=server_job_producer
INTERVIEW_MQ_ENABLED=true
INTERVIEW_MQ_CONSUMER_ENABLED=true

INTERVIEW_MQ_TOPIC_AI_TASK=interview_ai_task
INTERVIEW_MQ_TOPIC_AI_RESULT=interview_ai_result
INTERVIEW_MQ_TOPIC_TIMER=interview_timer_event
INTERVIEW_MQ_TOPIC_DLQ=interview_dlq
INTERVIEW_MQ_CONSUMER_AI_RESULT=server_job_interview_result_consumer
INTERVIEW_MQ_CONSUMER_AI_TASK=server_job_interview_task_consumer

# compose 须映射 18081:8081 与 8081:8081（路由二次连接用）
# broker.conf（docker 目录）brokerIP1=host.docker.internal 仅影响 Dashboard，不影响本机填写的 18081

# ====================== MinIO（头像上传）======================
# 须与 MinIO 容器 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 完全一致
MINIO_ENABLED=true
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=job-portal
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
