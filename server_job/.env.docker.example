# server_job 在 Docker 内运行时复制为 .env.docker
# 前提：~/workspace/docker 的 compose 已 up，且本 compose 加入同一网络 docker_app-network

# ---------- 数据存储（compose 服务名） ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=app_db
MYSQL_USER=root
MYSQL_PASSWORD=123456

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DATABASE=0

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root123
MONGODB_DATABASE=server_job

NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=123456

ELASTICSEARCH_HOST=es
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic123456

MINIO_ENABLED=true
MINIO_ENDPOINT=http://milvus-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=job-portal
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=Milvus

# ---------- ai_job（若仍在宿主机跑，用 host.docker.internal） ----------
AI_JOB_BASE_URL=http://host.docker.internal:8001

# ---------- RocketMQ ----------
# 容器内直连 Broker Proxy（与 broker.conf 中 proxyAdvertiseAddr 有关，见 docs/ROCKETMQ联调.md）
# 若消费/生产异常，可暂时 INTERVIEW_MQ_ENABLED=false，或把 broker.conf 的 proxyAdvertiseAddr 改为 rocketmq-broker:8081
ROCKETMQ_PROXY_GRPC_ENDPOINT=rocketmq-broker:8081
ROCKETMQ_PROXY_ENDPOINT=rocketmq-broker:8080
ROCKETMQ_SSL_ENABLED=false
INTERVIEW_MQ_ENABLED=true
INTERVIEW_MQ_CONSUMER_ENABLED=true
