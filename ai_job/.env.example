# ====================== RocketMQ ======================
# 5.x Python SDK：第 1 跳 Proxy（映射 18081:8081）；第 2 跳路由 Broker gRPC 为 *:8081，需 compose 映射 8081:8081
ROCKETMQ_PROXY_GRPC_ENDPOINT=127.0.0.1:18081
# 宿主机将路由里的 host.docker.internal / rocketmq-broker 重写为 127.0.0.1（见 app/mq/route_rewrite.py）
ROCKETMQ_ROUTE_REWRITE=1
# Spring / HTTP remoting（可选）
ROCKETMQ_PROXY_ENDPOINT=localhost:18080
# Apache rocketmq-client-python 连 NameServer（docker 映射 9876）
ROCKETMQ_NAMESERVER=localhost:9876
ROCKETMQ_ENABLED=1

# 生产者组（按进程角色）
ROCKETMQ_PRODUCER_GROUP=ai_job_a_producer
ROCKETMQ_PRODUCER_GROUP_WORKER=ai_job_b_producer
ROCKETMQ_PRODUCER_GROUP_SERVER=server_job_producer

# ai_job_b Worker 消费组
ROCKETMQ_CONSUMER_GROUP=ai_job_b_worker

# 面试 Topic（与 server_job interview.mq.topics 一致）
INTERVIEW_MQ_TOPIC_AI_TASK=interview_ai_task
INTERVIEW_MQ_TOPIC_AI_RESULT=interview_ai_result
INTERVIEW_MQ_TOPIC_TIMER=interview_timer_event
INTERVIEW_MQ_TOPIC_DLQ=interview_dlq
INTERVIEW_MQ_CONSUMER_AI_RESULT=server_job_interview_result_consumer

# ROLE005 / server_job 联调
ROLE=ai_job_a
ROLE005_INTERVIEW_ENABLED=1
# Planner 等 JSON Agent：json_object（默认）| none（仅靠 Prompt，本地网关不转发参数时用）
ROLE005_LLM_RESPONSE_FORMAT=json_object

# =========================
# 岗位推荐 LLM 分析（deal_data_by_llm / analyze_retrieval_sync）
# =========================
# 分析所用 chat 档位（modelCfg.json 的 model_level）
JOB_RAG_ANALYZE_MODEL_LEVEL=top
# response_format：auto（默认，随 JOB_RAG_ANALYZE_MODEL_LEVEL + modelCfg 联动）
# 显式覆盖：json_object | json_schema | none
JOB_RAG_ANALYZE_RESPONSE_FORMAT=auto
JOB_RAG_ANALYZE_MAX_TOKENS=20480
# LightRAG 关键词抽取：none（默认）| json_object；勿用库内 Pydantic GPTKeywordExtractionFormat
LIGHTRAG_KW_RESPONSE_FORMAT=none
# 规划图完成后投递 interview.plan.result（0 关闭）
ROLE005_PLAN_BANK_MQ_ENABLED=1
SERVER_JOB_BASE_URL=http://127.0.0.1:8002
SERVER_JOB_SERVICE_TOKEN=
