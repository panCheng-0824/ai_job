# =========================
# LightRAG 存储引擎选择
# =========================
# 图存储类型：
# - Neo4JStorage: 使用 Neo4j（生产推荐）
# - NetworkXStorage: 本地内存/文件（轻量调试）
# - PGGraphStorage / AGEStorage: PostgreSQL 相关实现
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage

# 向量存储类型：
# - MilvusVectorDBStorage: 使用 Milvus（生产推荐）
# - NanoVectorDBStorage: 本地轻量存储（快速调试）
# - FaissVectorDBStorage 等：按 LightRAG 支持项选择
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

# 当选择 MilvusVectorDBStorage 但 Milvus 变量缺失时，是否自动降级为 NanoVectorDBStorage
# 1 = 开启降级（默认更稳妥）
# 0 = 关闭降级（缺少配置时直接报错，便于排查）
LIGHTRAG_ALLOW_MILVUS_FALLBACK=1

# =========================
# Neo4j 数据源配置
# =========================
# Neo4j 连接地址（bolt/neo4j 协议均可，按你的部署填写）
NEO4J_URI=neo4j://127.0.0.1:7687
# Neo4j 用户名
NEO4J_USERNAME=neo4j
# Neo4j 密码（请替换为你的真实密码）
NEO4J_PASSWORD=pc0824tq
# 可选：指定数据库名（Neo4j 4.x+ 多数据库场景）
NEO4J_DATABASE=ai_job

# =========================
# Redis（与 server_job 共用，application.yml spring.data.redis / student.redis-key-prefix）
# =========================
# 登录后 Java 写入学生画像，ai_job 通过 app/student_redis.py 读取（键 = 前缀 + 学号）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pc0824tq
REDIS_DATABASE=0
# 可选：与 server_job 的 STUDENT_PROFILE_REDIS_PREFIX 保持一致
STUDENT_PROFILE_REDIS_PREFIX=student:profile:

# =========================
# Milvus 数据源配置
# =========================
# Milvus 服务地址（常见端口 19530）
MILVUS_URI=http://127.0.0.1:19530
# Milvus 数据库名（没有特殊需求可用 default）
MILVUS_DB_NAME=ai_job

# =========================
# LightRAG 运行参数
# =========================
# 本地服务地址绕过代理（避免 VPN/系统代理导致 127.0.0.1 请求被转发后出现 502）
NO_PROXY=127.0.0.1,localhost
# LightRAG 本地工作目录（索引/缓存等文件）
LIGHTRAG_WORKING_DIR=./rag_storage
# 逻辑工作空间名称（用于命名隔离）
LIGHTRAG_WORKSPACE=ai_job
# 查询模式：mix / local / global（取决于 LightRAG 版本支持）
LIGHTRAG_QUERY_MODE=mix

#mode	含义（通俗）
#local
#偏「局部」：更依赖与问题相关的实体/上下文（注释：context-dependent）。top_k 在该模式下主要对应实体规模（见同文件 QueryParam 对 top_k 的说明）。
#global
#偏「全局」：更依赖图谱里关系/全局摘要一类信息（注释：global knowledge）。top_k 更偏关系条数。
#hybrid
#local + global 两种检索方式一起用（注释：Combines local and global）。
#naive
#朴素检索：走 naive_query，主要是向量块检索（chunks_vdb），不做前面那套「图谱 + 向量」的复杂组合（注释：basic search without advanced techniques）。
#mix
#图谱 + 向量一起参与检索与上下文组织（注释：Integrates knowledge graph and vector retrieval）。你们默认用的就是这个。
#bypass
#不做知识检索：不调 RAG 检索链路，直接把问题交给 llm_model_func（等价于普通聊天）。见 lightrag.py 里 "Bypass mode: directly use LLM without knowledge retrieval"。
# 检索召回数量（越大召回越多，耗时可能增加）
LIGHTRAG_TOP_K=5
# 向量检索相似度阈值（LightRAG 读环境变量 COSINE_THRESHOLD，默认 0.2；调高通常更「严」、召回更少，需结合 Milvus 实测）
COSINE_THRESHOLD=0.2

# =========================
# LightRAG 模型配置（可选）
# =========================
# 使用方式：
# - 推荐：只配置 TYPE + LEVEL，从 config/modelCfg.json 自动读取 name/api/key
# - 可选：若同时配置 NAME/API/KEY，则优先使用 .env 直配模型
# 模型档位（可与 modelCfg.json 保持一致：low / mid / high）
LIGHTRAG_MODEL_LEVEL=mid
# 模型类型（与 modelCfg.json 的 model_type 对齐，LightRAG 聊天场景建议 chat）
LIGHTRAG_MODEL_TYPE=chat
## 模型提供方标识（当前实现主要走 openai 兼容协议）
#LIGHTRAG_MODEL_PROVIDER=openai
## 聊天模型名（需在 /v1/models 中可见）
#LIGHTRAG_MODEL_NAME=gemma-4-26b-a4b-it-4bit
## OpenAI 兼容服务地址
#LIGHTRAG_MODEL_API=http://127.0.0.1:8000/v1
## 接口鉴权 Key
#LIGHTRAG_MODEL_KEY=pc0824tq

# =========================
# Embedding 配置（关键）
# =========================
# 推荐：按 type + level 从 modelCfg.json 读取 embedding 配置
LIGHTRAG_EMBED_TYPE=embedding
LIGHTRAG_EMBED_LEVEL=mid
# LightRAG embedding 并发 worker 数，建议本地环境先设为 1 稳定运行
EMBEDDING_FUNC_MAX_ASYNC=1
## embedding 模型名（可选直配）。不填则按上面 TYPE+LEVEL 读取，读不到再回退 chat 模型。
#LIGHTRAG_EMBED_MODEL=gemma-4-26b-a4b-it-4bit
## 可选：单独指定 embedding API 地址；不填则使用 modelCfg 中 embedding 项或聊天模型地址
#LIGHTRAG_EMBED_API=http://127.0.0.1:8000/v1
## 可选：单独指定 embedding Key；不填则使用 modelCfg 中 embedding 项或聊天模型 Key
#LIGHTRAG_EMBED_KEY=pc0824tq
## embedding 向量维度，需要和模型实际输出一致；不一致会导致入库失败。
LIGHTRAG_EMBED_DIM=1536
## 单次 embedding 最大 token 数
#LIGHTRAG_EMBED_MAX_TOKENS=8192

# =========================
# 写入前文档清洗（可选 LLM，对齐 embedding 的 type/level + 直配）
# =========================
# 0 = 仅 strip；1 = strip 后再调用下方配置的聊天模型做文档清洗
LIGHTRAG_DOC_CLEAN_ENABLED=0
 从 modelCfg.json 选择的模型类型与档位（默认 chat + 与 LIGHTRAG_MODEL_LEVEL 一致）
LIGHTRAG_DOC_CLEAN_TYPE=chat
LIGHTRAG_DOC_CLEAN_LEVEL=mid
# 直配覆盖（三件套齐全时优先于 modelCfg）
#LIGHTRAG_DOC_CLEAN_MODEL=gemma-4-26b-a4b-it-4bit
#LIGHTRAG_DOC_CLEAN_API=http://127.0.0.1:8000/v1
#LIGHTRAG_DOC_CLEAN_KEY=pc0824tq
# 采样温度、并发清洗条数；超长跳过 LLM（0 表示不限制）
#LIGHTRAG_DOC_CLEAN_TEMPERATURE=0
#LIGHTRAG_DOC_CLEAN_MAX_ASYNC=1
#LIGHTRAG_DOC_CLEAN_MAX_CHARS=0
# LLM 失败时：fallback=保留 strip 原文；fail=抛出中断写入
#LIGHTRAG_DOC_CLEAN_ON_ERROR=fallback
# 可选：自定义系统提示（多行请使用引号或单独配置文件，此处留空则用内置中文默认提示）
#LIGHTRAG_DOC_CLEAN_SYSTEM_PROMPT=

# =========================
# 岗位推荐：ai_job 拉取 server_job 元数据（与 LightRAG 校验 job_id）
# =========================
# 示例：与 web_job 同源后端
SERVER_JOB_BASE_URL=http://127.0.0.1:8080
# 岗位推荐检索前 LLM 改写：1/true/on 关闭改写（直接用原文检索）
#JOB_RAG_QUERY_REWRITE_DISABLED=0
# 改写所用 chat 档位（对应 modelCfg.json 的 model_level）
JOB_RAG_QUERY_REWRITE_MODEL_LEVEL=mid

# =========================
# 岗位推荐 LLM 分析（DeepSeek / OpenAI 兼容）
# =========================
JOB_RAG_ANALYZE_MODEL_LEVEL=mid
# response_format：DeepSeek 不支持 json_schema / Pydantic 结构化 API
# - none：不传 response_format，靠 Prompt + parse_recom_json（推荐 DeepSeek）
# - json_object：先尝试 API 约束 JSON，失败自动回退（默认代码行为，DeepSeek 可能仍 400 后回退）
# - json_schema：仅 OpenAI 等支持 Structured Outputs 的模型
JOB_RAG_ANALYZE_RESPONSE_FORMAT=none
# 分析最大输出 token
JOB_RAG_ANALYZE_MAX_TOKENS=2048

# LightRAG 查询时关键词抽取（mix/local/global 模式）
# DeepSeek 勿用库内 GPTKeywordExtractionFormat；none=仅 Prompt 要求 JSON
LIGHTRAG_KW_RESPONSE_FORMAT=none

# 岗位推荐语义缓存（/api/skills/job-info-query）
# =========================
# 依赖：上方 REDIS_* 已配置；Embedding 使用 LIGHTRAG_EMBED_*（或 JOB_INFO_SEM_CACHE_EMBED_LEVEL）
# 前端「使用语义缓存」勾选 + 本开关为 1 时才会读/写缓存；响应命中时顶层带 cache 字段
# 总开关：1/true/yes/on 启用语义+精确缓存；0 或未设则关闭（默认关）
JOB_INFO_SEM_CACHE_ENABLED=1
# 单条缓存存活时间（秒），到期后不再命中；最小 60，默认 3600（1 小时）
JOB_INFO_SEM_CACHE_TTL_SEC=3600
# 语义命中阈值：改写句向量与历史条目的余弦相似度 ≥ 该值才返回旧结果
# 越高越严、误命中越少但命中率下降；默认 0.94
JOB_INFO_SEM_CACHE_THRESHOLD=0.94
# 知识库版本号：岗位/企业语料大更新后改一次（如 v1→v2），旧 scope 缓存自动隔离
# 不填则自动用 LIGHTRAG_WORKDIR 或 greprag_db.json 的 mtime 作为指纹
# JOB_INFO_SEM_CACHE_KB_VERSION=v1
# ---------- 以下为进阶项，一般可不配 ----------
# 每个「缓存分区」内最多保留多少条语义记录，超出淘汰最旧；默认 300
JOB_INFO_SEM_CACHE_MAX_ENTRIES=300
# 是否启用「改写句 rag_q 完全一致」的精确缓存（不调 embedding）；默认开
JOB_INFO_SEM_CACHE_EXACT_ENABLED=1
# 缓存用 embedding 档位；不填则跟 LIGHTRAG_EMBED_LEVEL
JOB_INFO_SEM_CACHE_EMBED_LEVEL=mid
# 1：学生画像 student_context 参与分区与指纹（不同学生会分开缓存）；默认开
JOB_INFO_SEM_CACHE_INCLUDE_PROFILE=1
